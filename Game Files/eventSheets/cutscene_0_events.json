{
	"name": "cutscene_0_events",
	"events": [
		{
			"eventType": "comment",
			"text": "Initialize cutscene dialogue array (cutscene_n_dialogue object) on startup.\nThis array is an x by y array, where:\n- x (ie width) is the total dialogue count of this cutscene\n- y (ie height) is the number of attributes to keep track of per dialogue \n   - y = 4 for now, we keep track of text, current speaking position, character name, and voiceline to play per dialogue\n      - (x, 0) stores text, (x, 1) stores current speaking character's position, (x, 2) stores character name, (x, 3) stores voiceline file name"
		},
		{
			"eventType": "comment",
			"text": "NOTE: certain setup needs to be done on layer\n- setting initial left/right character sprite (select sprite->properties->initial animation)\n- setting how many dialogues are in this cutscene (select c1_arr->properties->width)"
		},
