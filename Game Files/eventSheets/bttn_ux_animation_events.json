					"id": "set-boolean-eventvar",
					"objectClass": "System",
					"sid": 567193504142908,
					"parameters": {
						"variable": "ClickOnCooldown",
						"value": "true"
					}
				},
				{
					"id": "wait",
					"objectClass": "System",
					"sid": 698546011882560,
					"parameters": {
						"seconds": "0.25",
						"use-timescale": true
