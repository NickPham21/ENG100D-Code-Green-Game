{
	"name": "music_events",
	"events": [
		{
			"eventType": "comment",
			"text": "Music Events: contains functions that are responsible for playing music.\n\nmusic_start(String layout_name): starts playing music (fading in) for that layout. Ideally should be called at the start of every layout.\nmusic_end(String layout_name): stops playing music (fading out) that was originally played in that layout. Ideally should be called before transitioning to another layout.\n\nNOTE: Function does not need to be called at every start/transition if you want music to linger across multiple layouts"
		},
		{
			"functionName": "music_start",
			"functionDescription": "Starts playing music for the layout name passed in.",
			"functionCategory": "",
			"functionReturnType": "none",
			"functionCopyPicked": false,
			"functionIsAsync": false,
			"functionParameters": [
				{
					"name": "layout_name",
					"type": "string",
					"initialValue": "",
					"comment": "Name of layout to play music for.",
					"sid": 738175494583748
				}
			],
			"eventType": "function-block",
			"conditions": [],
			"actions": [
				{
					"type": "comment",
					"text": "Fade in music for that layout (from silent to MusicVolume)\nException for cutscene music, which fades from silent to MusicVolume - 15 so voicelines can be heard"
				}
			],
			"sid": 656997849066777,
			"children": [
				{
